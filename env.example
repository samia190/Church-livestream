NODE_ENV=development
PORT=3000
MONGODB_URI=
JWT_SECRET=replace-with-at-least-32-random-characters
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
RESTREAM_API_KEY=

# Public callback origin used by payment providers
PUBLIC_BASE_URL=https://your-production-domain.example

# Safaricom Daraja M-PESA PayBill STK Push (sandbox or production base URL)
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PAYBILL_NUMBER=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Optional: expose the public PayBill number in the donation form
VITE_MPESA_PAYBILL_NUMBER=

# PayPal REST checkout (sandbox or production base URL)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Stripe hosted Checkout for international card payments
# Keep the secret key and webhook secret server-side; do not use VITE_ for either value.
STRIPE_BASE_URL=https://api.stripe.com/v1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Restream: add later when external streaming accounts are ready
# RESTREAM_API_KEY=

# Provider-neutral background reminder delivery
# The webhook should hand off to an email or push provider such as Resend, SendGrid, SES, or a church notification service.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
NOTIFICATION_CRON_SECRET=replace-with-a-long-random-secret

# Optional TURN service for reliable multi-party WebRTC through restrictive NATs.
# Use short-lived/provider-minted credentials; client-side values are visible to the browser.
# VITE_TURN_URLS=turn:turn.example.org:3478,turns:turn.example.org:5349
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# External scheduler should call this endpoint every 5 minutes with the cron secret:
# POST /api/notifications/dispatch/prayer-room

# Optional Google Maps integration used by MapView
# VITE_FRONTEND_FORGE_API_KEY=
# VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev
# VITE_GOOGLE_MAP_ID=

# Optional managed SFU for scalable congregation livestreaming
# Keep API key and secret server-side; expose only the public URL to the browser.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
